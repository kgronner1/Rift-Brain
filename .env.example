# Copy to .env (chmod 600). On the box, infra/box/provision.sh writes it (RJ 463). Validated at boot by src/config/env.js, which lists every problem at once.
#
# Leave ENV unset for the legacy brain: it then listens on every interface on 3000, spawns
# /home/ec2-user/rift_jumper_multiplayer_server_test.x86_64 on UDP 8080-8085, exactly as before RJ 462,
# and needs only the MYSQL_* lines.

# legacy (unset) | dev | alpha | prod
ENV=dev

MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
MYSQL_USER=rift_brain_dev
MYSQL_PASSWORD=
MYSQL_DATABASE=rift_brain_dev

# Required unless ENV is unset. BIND_HOST defaults to 127.0.0.1 (Caddy fronts it) unless ENV is unset.
# INTERNAL_PORT is the game servers' API (/internal/v1), always on 127.0.0.1 and never proxied.
PUBLIC_PORT=3001
INTERNAL_PORT=3101
# BIND_HOST=127.0.0.1
GAME_PORTS=8100-8104
# What /v1/match/join hands the client as `host`.
GAME_HOST=play.riftjumpers.space
# One server binary per wire protocol (RJ 466): SERVERS_DIR/manifest.json names them (README, "Matchmaking").
SERVERS_DIR=/opt/rj/dev/servers
# Optional: each game server's output, as <dir>/lobby-<id>.log. Unset: discarded.
# SERVER_LOGS_DIR=/opt/rj/dev/logs/servers
# The legacy brain's single binary; ignored unless ENV is unset.
# SERVER_BINARY=/home/ec2-user/rift_jumper_multiplayer_server_test.x86_64

# 32 bytes as 64 hex characters each: openssl rand -hex 32. Never commit real keys. All three are required unless ENV
# is unset, and must differ. SESSION_KEY signs /v1 sessions (RJ 465); JOIN_KEY signs join tokens, and game servers get
# it as RJ_JOIN_KEY; LOBBY_MASTER_KEY derives each lobby's key (RJ_LOBBY_KEY), and never leaves the brain (RJ 466).
SESSION_KEY=
JOIN_KEY=
LOBBY_MASTER_KEY=
# The remote config document /v1's gates and rate limits come from, read every 30 s. Unset: the compiled defaults.
# CONFIG_URL=https://config.riftjumpers.space/dev/client.v1.json
