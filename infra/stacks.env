# The infrastructure's fixed, public settings (RJ 463). Sourced by infra/*.sh and ops/config/*.sh.
# Nothing here is a secret: the repository is public. Machine-specific values (the PEM, the SSH host, the CIDRs
# allowed to SSH) live in ~/.config/rift-jumpers/deploy.env instead.

RJ_DOMAIN=riftjumpers.space
RJ_AWS_PROFILE="${RJ_AWS_PROFILE:-rj}"

# rj-edge: config.<domain> (S3 + CloudFront + its certificate). us-east-1, because CloudFront only takes ACM
# certificates from there.
RJ_EDGE_STACK=rj-edge
RJ_EDGE_REGION=us-east-1

# rj-box: the box's security group rj-public and the api / api-dev / play records. The box is in us-west-1.
RJ_BOX_STACK=rj-box
RJ_BOX_REGION=us-west-1

RJ_CONFIG_HOST="config.$RJ_DOMAIN"
